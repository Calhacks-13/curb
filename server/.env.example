# Curb Server Configuration
# Copy to .env and fill in values. All vars use CURB_ prefix.

# --- Detection Tracking ---
CURB_MIN_GAP_FRACTION=0.15
CURB_TRACK_IOU_THRESHOLD=0.2
CURB_TRACK_MAX_AGE=5
CURB_TRACK_CONFIRM_HITS=2
CURB_GAP_CONFIRM_SEC=2.0
CURB_GAP_EXPIRE_SEC=1.5
CURB_OCCUPANCY_CONFIRM_SEC=2.0
CURB_OCCUPANCY_CONFIRM_HITS=3
CURB_OCCUPANCY_ANCHOR_IOU=0.8
CURB_OCCUPANCY_BLOCKER_IOU=0.8
CURB_OCCUPANCY_GAP_OVERLAP=0.6
CURB_OCCUPANCY_MIN_CONFIDENCE=0.6
CURB_OCCUPANCY_MAX_HEADING_CHANGE=10.0
CURB_OCCUPANCY_MAX_MOTION_M=5.0
CURB_SPOT_FRESHNESS_SEC=300

# --- Sign Confidence ---
CURB_SIGN_READ_CONFIDENCE_THRESHOLD=0.5

# --- Block-level Snapping ---
CURB_GRID_PRECISION=3

# --- Spot TTL (seconds) ---
CURB_DEFAULT_TTL_SEC=1800
CURB_DOWNTOWN_TTL_SEC=900
CURB_SUBURB_TTL_SEC=3600

# --- Azure Cosmos DB ---
CURB_COSMOS_ENDPOINT=
CURB_COSMOS_KEY=
CURB_COSMOS_DATABASE=curb

# --- Azure SignalR (legacy web client) ---
CURB_SIGNALR_CONNECTION_STRING=

# --- Azure Web PubSub (mobile app realtime) ---
CURB_WEBPUBSUB_CONNECTION_STRING=
CURB_WEBPUBSUB_HUB=curb

# Same value as CURB_PAYMENT_SERVICE_TOKEN in payments/.env
CURB_PAYMENT_SERVICE_TOKEN=

# --- Anthropic ---
CURB_ANTHROPIC_API_KEY=
# Or set ANTHROPIC_API_KEY directly (SDK default)
