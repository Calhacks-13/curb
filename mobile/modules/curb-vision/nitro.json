{
  "$schema": "https://nitro.margelo.com/nitro.schema.json",
  "cxxNamespace": ["curbvision"],
  "ios": { "iosModuleName": "CurbVision" },
  "android": {
    "androidNamespace": ["curbvision"],
    "androidCxxLibName": "CurbVision"
  },
  "autolinking": {
    "CurbVision": {
      "ios": {
        "language": "swift",
        "implementationClassName": "HybridCurbVision"
      }
    }
  },
  "ignorePaths": ["**/node_modules"]
}
